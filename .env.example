# ==============================================================================
# SETTLR: Production & Staging Environment Variables
# Copy this file to .env.local for local development or input into Vercel settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Free Tier: https://supabase.com)
# ------------------------------------------------------------------------------
# Obtained from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Service role key for backend admin operations / cron tasks (KEEP SECRET)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Multimodal AI API (Google AI Studio Free Tier: https://aistudio.google.com)
# ------------------------------------------------------------------------------
# Used for Autonomous Contract Risk Analysis and Receipt OCR Capabilities
GEMINI_API_KEY=AIzaSy...your-api-key-here

# ------------------------------------------------------------------------------
# 3. Direct Zero-Fee UPI & Gateway Configuration
# ------------------------------------------------------------------------------
# Your Business/Personal UPI ID for receiving 0% fee payments (GPay/PhonePe/Paytm/BHIM)
NEXT_PUBLIC_MERCHANT_UPI_ID=settlr@upi
MERCHANT_NAME="Settlr Technologies"

# Optional: YouPI-PG Gateway (https://github.com/youpi-pg/YouPI-PG)
NEXT_PUBLIC_YOUPI_CHECKOUT_URL=http://localhost:7000
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=your_youpi_merchant_uuid_here
YOUPI_MERCHANT_API_KEY=your_youpi_merchant_api_key_here
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret_here

# Optional Legacy Gateway Fallback (Razorpay)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# ------------------------------------------------------------------------------
# 4. Application URL & Domain Config
# ------------------------------------------------------------------------------
# The fully qualified public origin of your application
NEXT_PUBLIC_APP_URL=https://usesettlr.in
