# ==============================================================================
# SETTLR: Production & Staging Environment Variables
# Copy this file to .env.local for local development or input into Vercel settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Free Tier: https://supabase.com)
# ------------------------------------------------------------------------------
# Obtained from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Service role key for backend admin operations / cron tasks (KEEP SECRET)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API (Free Tier: https://aistudio.google.com)
# ------------------------------------------------------------------------------
# Used for AI Contract Analysis, MSME Redline Extraction, and Receipt OCR
GEMINI_API_KEY=AIzaSy...your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Standard / Test Mode: https://dashboard.razorpay.com)
# ------------------------------------------------------------------------------
# Client-side Key ID (begins with rzp_live_ in production, rzp_test_ in development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Server-side Key ID & Key Secret (Used for HMAC SHA256 Signature Verification)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# ------------------------------------------------------------------------------
# 4. Application URL & Domain Config
# ------------------------------------------------------------------------------
# The fully qualified public origin of your application
NEXT_PUBLIC_APP_URL=https://usesettlr.in
